# .env.example — copy to .env.local (never commit real values).
# EXPO_PUBLIC_* values are embedded in the app binary => PUBLIC. Never put secrets there.

# ---------- Mobile app (apps/mobile) — public ----------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-or-publishable-key
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com   # TODO(verify): US or EU cloud
EXPO_PUBLIC_APP_ENV=local                            # local | staging | production
EXPO_PUBLIC_DEFAULT_LOCALE=fr

# ---------- Build / tooling (EAS, CI) ----------
# The Expo project id lives only in apps/mobile/app.config.ts (EAS_PROJECT_ID).
SENTRY_AUTH_TOKEN=            # CI/EAS secret only (source maps upload)
SENTRY_ORG=
SENTRY_PROJECT=

# Edge Functions — set with `supabase secrets set`, never in the app binary.
SENTRY_DSN=
APP_ENV=local
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase in hosted functions.
SUPABASE_SERVICE_ROLE_KEY=never-use-in-apps-folder

AI_PROVIDER=replace-me                # e.g. openai | anthropic | google | xai | mistral (decision)
AI_API_KEY=replace-me
AI_VISION_MODEL=replace-me
AI_PLAN_MODEL=replace-me
AI_TRANSCRIBE_MODEL=replace-me
AI_GENERATION_ENABLED=true            # kill switch
AI_MAX_COST_USD_PER_PLAN=0.50         # TODO(verify) target

RATE_LIMIT_PLANS_PER_DAY=3
RATE_LIMIT_PHOTOS_PER_DAY=40

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PLAN_49=price_replace_me
STRIPE_PRICE_PLAN_99=price_replace_me
CHECKOUT_SUCCESS_URL=renoroute://plan/payment-result?status=success   # scheme from BRAND.scheme
CHECKOUT_CANCEL_URL=renoroute://plan/payment-result?status=cancel

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_ALERT_EMAIL=you@example.com
