# .env.example — copy to .env.local (never commit real values).
# EXPO_PUBLIC_* values are embedded in the app binary => PUBLIC. Never put secrets there.

# ---------- Mobile app (apps/mobile) — public ----------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-or-publishable-key
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com   # TODO(verify): US or EU cloud
EXPO_PUBLIC_APP_ENV=local                            # local | staging | production
EXPO_PUBLIC_DEFAULT_LOCALE=fr

# ---------- Build / tooling (EAS, CI) ----------
# The Expo project id lives only in apps/mobile/app.config.ts (EAS_PROJECT_ID).
SENTRY_AUTH_TOKEN=            # CI/EAS secret only (source maps upload)
SENTRY_ORG=
SENTRY_PROJECT=

# Edge Functions — set with `supabase secrets set`, never in the app binary.
SENTRY_DSN=
APP_ENV=local
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase in hosted functions.
SUPABASE_SERVICE_ROLE_KEY=never-use-in-apps-folder

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-me         # or AI_API_KEY; never in the app binary
AI_API_KEY=replace-me
AI_VISION_MODEL=openrouter/auto       # leave as auto: OpenRouter picks the current best vision model
AI_PLAN_MODEL=openrouter/auto         # leave as auto: OpenRouter picks the current best plan model
AI_IMAGE_MODEL=openrouter/auto        # leave as auto: OpenRouter picks the current best image model
AI_TRANSCRIBE_MODEL=openrouter/auto
AI_GENERATION_ENABLED=true            # kill switch
AI_IMAGE_PREVIEW_ENABLED=true         # before/after illustration; can be turned off alone
AI_MAX_COST_USD_PER_PLAN=0.50         # TODO(verify) target; image previews may exceed this

RATE_LIMIT_PLANS_PER_DAY=3
RATE_LIMIT_PHOTOS_PER_DAY=40

# Payments (ADR-011). Copy real values to .env.local (gitignored) or
# `supabase secrets set`. Never commit keys. Live checkout is
# BLOCKED: needs Brown keys. App and tests use mocks until then.
#
# Product IDs (not secrets; same string on Stripe lookup_key, App Store, Play, RevenueCat):
#   renoroute_plan_standard
#   renoroute_plan_premium
# Amounts live only in packages/shared/src/payments/products.ts (4900 / 9900 CAD cents).
STRIPE_SECRET_KEY=sk_test_replace_me             # server only
STRIPE_WEBHOOK_SECRET=whsec_replace_me           # server only
CHECKOUT_SUCCESS_URL=renoroute://plan/payment-result?status=success   # scheme from BRAND.scheme
CHECKOUT_CANCEL_URL=renoroute://plan/payment-result?status=cancel
EXPO_PUBLIC_REVENUECAT_API_KEY=appl_replace_me   # public SDK key; still a placeholder
REVENUECAT_WEBHOOK_AUTH=replace_me               # server only; Authorization header

# ---------- Social auth (M1-09) — public IDs only in EXPO_PUBLIC_* ----------
# Live sign-in is BLOCKED: needs Brown keys. Placeholders start with replace-.
# See docs/auth-setup.md for the exact apps and redirect URIs Brown must create.
EXPO_PUBLIC_APPLE_SERVICE_ID=replace-apple-service-id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-google-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace-google-ios-client-id
EXPO_PUBLIC_FACEBOOK_APP_ID=replace-facebook-app-id
EXPO_PUBLIC_TIKTOK_CLIENT_KEY=replace-tiktok-client-key
TIKTOK_CLIENT_SECRET=replace-tiktok-client-secret   # supabase secrets set only — never in the app

# ---------- Auth email SMTP (M1-04) ----------
# Create the SMTP account yourself. Set these in the Supabase dashboard or
# `supabase secrets set`, never in this file. SPF/DKIM is NOT verified.
# SMTP_HOST=replace-with-smtp-host
# SMTP_PORT=replace-with-smtp-port
# SMTP_USER=replace-with-smtp-user
# SMTP_PASS=replace-with-smtp-password
# SMTP_SENDER=replace-with-sender-address
ADMIN_ALERT_EMAIL=you@example.com
# Weekly stale-program alert (M5-06): GitHub Action `.github/workflows/stale-rebate-alert.yml`.
# Sending mail is BLOCKED until Brown sets a real mailbox secret (not example.com).
